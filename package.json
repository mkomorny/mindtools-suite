{
  "name": "mindtools-suite",
  "version": "4.0.0",
  "description": "MindTools Suite - AI-powered thinking and communication tools",
  "author": "",
  "private": false,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const f=require('fs');['dist','dist-desktop','server.js'].forEach(d=>{try{f.rmSync(d,{recursive:true,force:true})}catch{}})\"",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder build --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.45.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.mindtools.suite",
    "productName": "MindTools Suite",
    "icon": "MindTools.png",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json",
      "MindTools.png",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "MindTools.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MindTools Suite"
    }
  }
}